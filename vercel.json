{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "coffee-mill-compare\\.vercel\\.app"
        }
      ],
      "destination": "https://ouchi-dougubako.com/$1",
      "permanent": true
    },
    {
      "source": "/camping",
      "destination": "/articles/cold-brew-outdoor-coffee/",
      "permanent": true
    },
    {
      "source": "/camping/",
      "destination": "/articles/cold-brew-outdoor-coffee/",
      "permanent": true
    },
    {
      "source": "/en/camping",
      "destination": "/en/articles/epeios-essence-go/",
      "permanent": true
    },
    {
      "source": "/en/camping/",
      "destination": "/en/articles/epeios-essence-go/",
      "permanent": true
    }
  ]
}
